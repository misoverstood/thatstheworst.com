---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const network = [
  { name: "thatstheworst.com", url: "https://thatstheworst.com/", current: true },
  { name: "flemingdon.org", url: "https://flemingdon.org/" },
  { name: "muhummud.org", url: "https://muhummud.org/" },
  { name: "naseema.net", url: "https://naseema.net/" },
  { name: "iseentit.com", url: "https://iseentit.com/" },
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <nav
    aria-label="Other sites"
    class="border-border flex flex-wrap items-center justify-center gap-x-2 gap-y-1 border-t py-6 text-sm sm:py-5"
  >
    {
      network.map((site, i) => (
        <>
          {i > 0 && <span class="text-foreground/40 select-none">&middot;</span>}
          {site.current ? (
            <span class="text-foreground/50" aria-current="page">
              {site.name}
            </span>
          ) : (
            <a
              href={site.url}
              class="hover:text-accent underline decoration-dashed underline-offset-4"
            >
              {site.name}
            </a>
          )}
        </>
      ))
    }
  </nav>
</footer>
